# Copy to .env.local and fill in. Never commit the filled file.
# .env.local is gitignored; these values also live in GitHub Actions secrets.

# Airtable (read-only token, scoped to the portfolio base)
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=

# Cloudinary (key scoped to upload)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Set to 'true' to upload images to Cloudinary during a sync.
# Local runs without credentials preserve the existing files instead.
USE_CLOUDINARY=false
